# Shophippy API configuration (copy to .env)
SHOPHIPPY_DATABASE_URL=postgres://shophippy:shophippy@localhost:5432/shophippy
SHOPHIPPY_REDIS_URL=redis://localhost:6379
SHOPHIPPY_BIND_ADDR=0.0.0.0:8080

# Managed cloud = true charges the 0.5%-1.5% gateway fee on every payment.
# Self-hosted (false) runs the fee engine at zero gateway fee (free core).
SHOPHIPPY_MANAGED_CLOUD=false

# Demo merchant API key used by the docker-compose quick start.
# sha256 of this value is stored in the merchants table at startup.
SHOPHIPPY_DEMO_API_KEY=sk_live_demo_merchant

# Admin token for fee-rule management endpoints (per-merchant / per-corridor rules).
SHOPHIPPY_ADMIN_TOKEN=dev_admin

# Admin console login (email + password via POST /v1/admin/login).
# The password is argon2-hashed into admin_users at first startup and never
# stored in plaintext afterwards. Omit to disable console login.
SHOPHIPPY_ADMIN_EMAIL=admin@shophippy.dev
SHOPHIPPY_ADMIN_PASSWORD=change_me_strong_password

# Connector credentials. Leave empty to run connectors in simulated sandbox mode
# (useful for local development without external accounts).
STRIPE_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

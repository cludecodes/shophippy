DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Admin dashboard (owner sign-in for /admin). REQUIRED for admin access.
# Use a long random password; the session secret is derived from it unless
# ADMIN_SESSION_SECRET (32+ chars) is also set.
ADMIN_PASSWORD=<long-random-password>
ADMIN_SESSION_SECRET=<32+-char-random-secret>

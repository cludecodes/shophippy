{
  "name": "shophippy-vscode",
  "private": true,
  "type": "module",
  "workspaces": [
    "shophippy-studio"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"node server/index.js\" \"npm run dev --workspace shophippy\"",
    "build": "npm run build --workspace shophippy",
    "preview": "node server/index.js --production",
    "start": "node server/index.js --production",
    "migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "concurrently": "^9.2.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "pg": "^8.23.1"
  }
}
